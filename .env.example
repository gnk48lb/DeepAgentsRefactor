# LLM / AI API Keys
GEMINI_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
SILICON_FLOW_API_KEY=

# Magpie 本地模型网关（Anthropic Messages 协议；base URL 不带 /v1）
# MAGPIE_BASE_URL=http://127.0.0.1:3425
# MAGPIE_API_KEY=local
# MAGPIE_MODEL=minimax-code/MiniMax-M3.1-Flash
# MAGPIE_MAX_TOKENS=16384
# MAGPIE_TIMEOUT_SECONDS=600
# MAGPIE_MAX_RETRIES=2

# Search & Tool API Keys
AMAP_API_KEY=
TAVILY_API_KEY=

# Workspace Path
WORKSPACE_DIR=

# Milvus Vector Database
MILVUS_COLLECTION_NAME=
MILVUS_MEDIA_COLLECTION_NAME=
MILVUS_MEMORY_COLLECTION_NAME=
MILVUS_DB_PATH=

# MySQL Database
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Neo4j Graph Database
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Optional Cloudflare Workers AI Embeddings
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3

# 可迁移角色：provider 可选 magpie / gemini；模型名未填写时按 provider 自动选默认值
# WORKER_LLM_PROVIDER=magpie
# WORKER_LLM_MODEL=
# ORCHESTRATOR_LLM_PROVIDER=magpie
# ORCHESTRATOR_LLM_MODEL=
# KNOWLEDGE_LLM_PROVIDER=magpie
# KNOWLEDGE_LLM_MODEL=
# INGESTION_VLM_PROVIDER=magpie
# INGESTION_VLM_MODEL=
# BROWSER_VLM_PROVIDER=magpie
# BROWSER_VLM_MODEL=
# DESKTOP_VLM_PROVIDER=magpie
# DESKTOP_VLM_MODEL=

# 固定保留 Gemini 的轻量/稳定角色（只能覆盖模型名）
# UTILITY_LLM_MODEL=gemini-3.5-flash-lite
# VLM_MODEL=gemini-3.5-flash-lite
# EXTRACTOR_LLM_MODEL=gemini-3.5-flash-lite

# MarkItDown MCP Configuration
# MARKITDOWN_ALLOW_HTTP=false

# Jina Reader API Key (Optional)
# JINA_API_KEY=

# CLI Debug & Logging Configuration
# CLI_DEBUG=1
# CLI_DEBUG_MAX_CHARS=600

# Docker Code Sandbox Configuration (Optional)
# DOCKER_IMAGE_NAME=python-ds:latest
# DOCKER_MAX_MEM=1g
# DOCKER_PIDS_LIMIT=128
# DOCKER_NANO_CPUS=1000000000
# SANDBOX_TIMEOUT_SECONDS=60
# SANDBOX_MAX_TIMEOUT_SECONDS=300
# SANDBOX_IDLE_TTL_SECONDS=1800
# SANDBOX_MAX_STDOUT_CHARS=8000
# SANDBOX_MAX_STDERR_CHARS=3000
# SANDBOX_EXECUTE_MAX_OUTPUT_CHARS=2000000
# SANDBOX_WORK_TMPFS_MB=256
# SANDBOX_MOUNT_WORKSPACE=true
# SANDBOX_IMAGE_VERSION=3
# SANDBOX_MAX_IMAGES=4
# SANDBOX_MAX_IMAGE_MB=10
# SANDBOX_USER_IMAGE_MAX_SIDE=1600
# SANDBOX_MODEL_IMAGE_MAX_SIDE=768

# ── Modal 云端沙箱（member 的 CodeAgent）──
# 不配置令牌则 member 没有代码能力，行为与阶段 1 一致。令牌只放在这个文件里，绝不会传进沙箱。
# 费用上限请在 Modal 控制台设置（应用层没有按用户的配额）。
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# MODAL_DISABLED=false
# MODAL_APP_NAME=gnk48-code-sandbox
# MODAL_IMAGE_NAME=gnk48-python-ds:v1
# MODAL_CPU_REQUEST=0.25
# MODAL_CPU_LIMIT=2.0
# MODAL_MEMORY_MB_REQUEST=512
# MODAL_MEMORY_MB_LIMIT=2048
# MODAL_IDLE_TIMEOUT_SECONDS=600
# MODAL_MAX_LIFETIME_SECONDS=3600
# MODAL_EXEC_TIMEOUT_SECONDS=120
# MODAL_EXEC_MAX_TIMEOUT_SECONDS=300
# MODAL_STARTUP_TIMEOUT_SECONDS=120
# MODAL_MAX_SANDBOXES_PER_USER=2
# MODAL_MAX_SANDBOXES_TOTAL=8
# MODAL_BLOCK_NETWORK=false
# soft=只杀命令进程、保留 /work；terminate=直接终止沙箱（/work 丢失）。以 tests/live_modal.py 的实测为准
# MODAL_INTERRUPT_MODE=soft
# MODAL_AUDIT_LOG=storage/modal_audit.log
# ── 走代理的机器（Windows 上开了系统代理 / Clash 的那些）需要装 modal[api-proxy-support]（含 python-socks），
#    否则 Modal 连不上，提示会是 "ConnectionError: Could not connect to the Modal server."（真因藏在 __cause__ 里）。
#    正常做法是把它装进依赖：uv add 'modal[api-proxy-support]'
#    万一装不上（或你就是不想走系统代理），就把下面这行打开，Modal 改为直连：
# MODAL_DISABLE_API_PROXY=1

# --- 部署形态 ---
# desktop（默认）：Windows 本机。owner 有全部 7 个专家（含 FileAgent / DesktopAgent / BrowserAgent / 本机 Docker 的 CodeAgent），
#   member 只有 Knowledge / Media / Map，配了上面的 Modal 令牌时多一个云端 CodeAgent。
# cloud：Linux 云主机。不碰这台机器本身：owner 与 member 共用同一张图（Knowledge / Media / Map，Modal 令牌齐全时再加云端 CodeAgent，
#   owner 的代码也走 Modal），KnowledgeAgent 多一个读网页的工具；不构建 FileAgent / DesktopAgent / BrowserAgent，不加载本机 MCP。
# 只能填 desktop 或 cloud（不区分大小写，留空等于 desktop）；写错会在启动时直接报错，不会回退成 desktop。
# cloud 下这些键不生效（没有宿主机 inbox、本机 Docker 沙箱、宿主机命令、浏览器与本机 MCP）：WORKSPACE_DIR、QQ_INBOX_TTL_DAYS、
#   DOCKER_* / SANDBOX_*、HOST_SHELL_*、BROWSER_*（DESKTOP_VLM_*、MARKITDOWN_* 同理）；cloud 下更关键的是 MODAL_*（owner 的代码与所有人的文件接收）与 TAVILY_API_KEY（读网页）。详见 README 2.13。
# DEPLOY_MODE=desktop

# --- 宿主机命令执行（FileAgent 的 run_host_command）---
# HOST_SHELL_TIMEOUT_SECONDS=60
# HOST_SHELL_MAX_TIMEOUT_SECONDS=180
# HOST_SHELL_MAX_OUTPUT_CHARS=30000
# HOST_SHELL_MAX_COMMAND_CHARS=2000
# 额外放行给命令子进程的环境变量名（逗号分隔）；默认只放行系统运行必需项和代理，绝不继承 .env 里的任何密钥
# HOST_SHELL_ENV_ALLOW=JAVA_HOME,GOPATH

# --- 多用户 ---
# owner = 命中下列平台 openid 的 QQ 用户（逗号分隔）+ 本地 CLI；其余好友是 member，
# member 没有文件 / 命令 / 桌面 / 浏览器能力；代码只能在云端沙箱里跑（见上面的 Modal 段）。openid 只在当前机器人 AppID 内有效：
# 换 AppID，或在沙箱 / 正式环境之间切换后，要重新私聊机器人发 /whoami 取得新的 ID。
# 首次使用：先用主号私聊机器人发 /whoami，把返回的“平台 ID”写到这里，然后重启。
# OWNER_USER_IDS=
# member 同时处理的轮数上限（owner 不占用；至少为 1）
# MAX_CONCURRENT_MEMBER_TURNS=3
# 新 member 的第一条回复前附带一次的欢迎语（留空用内置默认）
# MEMBER_WELCOME_TEXT=

# --- 会话层持久化（会话 / 事件日志 / 挂起授权，以及 LangGraph checkpoint）---
# 两个文件都含完整对话文本，位于被 git 忽略的 storage/
# SESSIONS_DB_PATH=storage/sessions.db
# CHECKPOINT_DB_PATH=storage/checkpoints.db
# 每轮正常结束后清理子专家嵌套命名空间的 checkpoint（截图 base64 会让它们膨胀）；根命名空间永不清理
# CHECKPOINT_PRUNE_NESTED=true

# --- NoneBot / QQ 官方机器人(仅 bot.py 需要;这些行写在 .env 文件里,NoneBot 自己读取它)---
# DRIVER=~fastapi+~httpx+~websockets
# QQ_IS_SANDBOX=false
# QQ_BOTS=[{"id": "你的AppID", "token": "你的Token", "secret": "你的AppSecret", "intent": {"c2c_group_at_messages": true, "direct_message": true}, "use_websocket": true}]

# --- QQ 文件接收（owner 落到 WORKSPACE_DIR/inbox/<会话>/；member 直接上传到云端沙箱 /work/uploads/，宿主机不落盘）---
# 总开关；关闭后只发文件会收到固定提示，带文字的消息会忽略附件
# QQ_FILE_ENABLED=true
# member 是否可用（另外要求云端 CodeAgent 已启用，即没有 MODAL_DISABLED 且令牌齐全）
# QQ_FILE_MEMBER_ENABLED=true
# owner 单文件上限（MB，1-100）
# QQ_FILE_MAX_MB_OWNER=20
# member 单文件上限（MB，1-50）
# QQ_FILE_MAX_MB_MEMBER=10
# 单个文件下载的总期限（秒，5-300），不含排队时间
# QQ_FILE_DOWNLOAD_TIMEOUT_SECONDS=30
# 单条事件最多处理几个文件（1-20）
# QQ_FILE_MAX_PER_MESSAGE=5
# 每个会话（自上次 /reset 起）最多接收几个文件（1-200）
# QQ_FILE_MAX_PER_SESSION=20
# 全局并发落地数（1-10），同时限制了驻留内存的 member 文件字节数
# QQ_FILE_MAX_CONCURRENT=3
# owner inbox 目录保留天数，0 = 不自动清理
# QQ_INBOX_TTL_DAYS=7
# 单次注入给主管的文件清单最多列几个文件（1-50，取最近的）
# QQ_FILE_INJECT_MAX_ITEMS=10
# 回执 / 清单里把文件名中的 "." 显示成 "[.]"，防止 QQ 把 a.py、README.md 之类当域名拒收；真机确认不拒收后可设为 false
# QQ_FILE_SAFE_NAMES=true

# --- 定时任务与主动推送（owner / member 在 QQ 私聊里用自然语言创建提醒，到点由机器人主动私聊推送）---
# 总开关，默认关闭。关闭时不创建 schedules.db、不编译无人值守图、不挂 schedule 工具、不启动调度器，/tasks 回复“定时任务功能未启用。”
# 开启后要重启 bot.py。只支持单实例；任务库是被 git 忽略的 storage/schedules.db
# SCHEDULER_ENABLED=false
# 业务时区（IANA 名）：“每天 8 点”、get_current_time 的输出都按它理解；已创建的任务记着创建时的时区，改这里不会挪动它们。
# VPS 上要把系统时区与它对齐（timedatectl set-timezone 或 TZ 环境变量）
# DEFAULT_TIMEZONE=Asia/Shanghai
# SCHEDULES_DB_PATH=storage/schedules.db
# 每个用户最多几个任务（进行中与暂停的一起算）
# SCHEDULER_MAX_JOBS_OWNER=30
# SCHEDULER_MAX_JOBS_MEMBER=5
# 重复任务相邻两次触发的最小间隔（分钟，1-1440）
# SCHEDULER_MIN_INTERVAL_MINUTES=30
# 到点后多久内还算按时（秒）；超过就记为错过，一次性任务会通知用户一次，重复任务静默跳过
# SCHEDULER_MISFIRE_GRACE_SECONDS=900
# 无人值守任务等该用户的锁的最长时间（秒），超时按“忙”重试
# SCHEDULER_LOCK_WAIT_SECONDS=60
# 同时在跑的定时任务数（1-16）
# SCHEDULER_MAX_CONCURRENT_RUNS=2
# 单条推送正文的字数上限（100-4000）；真机实测 4000 字可发
# SCHEDULER_PUSH_MAX_CHARS=1500
# 全局相邻两条推送的最小间隔（秒）
# SCHEDULER_PUSH_MIN_INTERVAL_SECONDS=0.5
# 连续失败几次后暂停该任务（用户可用 /tasks resume 恢复）
# SCHEDULER_MAX_CONSECUTIVE_FAILURES=3
# “忙”与临时推送错误的最多重试次数、相邻两次重试的间隔（秒）
# SCHEDULER_RETRY_MAX=3
# SCHEDULER_RETRY_DELAY_SECONDS=30
