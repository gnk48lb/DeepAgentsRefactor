# LLM / AI API Keys
GEMINI_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
SILICON_FLOW_API_KEY=

# Magpie 本地模型网关（Anthropic Messages 协议；base URL 不带 /v1）
# MAGPIE_BASE_URL=http://127.0.0.1:3425
# MAGPIE_API_KEY=local
# MAGPIE_MODEL=minimax-code-global/MiniMax-M3.1-Flash
# MAGPIE_MAX_TOKENS=16384
# MAGPIE_TIMEOUT_SECONDS=600
# MAGPIE_MAX_RETRIES=2

# Search & Tool API Keys
AMAP_API_KEY=
TAVILY_API_KEY=

# Workspace Path
WORKSPACE_DIR=

# Milvus Vector Database
MILVUS_COLLECTION_NAME=
MILVUS_MEDIA_COLLECTION_NAME=
MILVUS_MEMORY_COLLECTION_NAME=
MILVUS_DB_PATH=

# MySQL Database
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Neo4j Graph Database
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Optional Cloudflare Workers AI Embeddings
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3

# 可迁移角色：provider 可选 magpie / gemini；模型名未填写时按 provider 自动选默认值
# WORKER_LLM_PROVIDER=magpie
# WORKER_LLM_MODEL=
# ORCHESTRATOR_LLM_PROVIDER=magpie
# ORCHESTRATOR_LLM_MODEL=
# KNOWLEDGE_LLM_PROVIDER=magpie
# KNOWLEDGE_LLM_MODEL=
# INGESTION_VLM_PROVIDER=magpie
# INGESTION_VLM_MODEL=
# BROWSER_VLM_PROVIDER=magpie
# BROWSER_VLM_MODEL=
# DESKTOP_VLM_PROVIDER=magpie
# DESKTOP_VLM_MODEL=

# 固定保留 Gemini 的轻量/稳定角色（只能覆盖模型名）
# UTILITY_LLM_MODEL=gemini-3.5-flash-lite
# VLM_MODEL=gemini-3.5-flash-lite
# EXTRACTOR_LLM_MODEL=gemini-3.5-flash-lite

# MarkItDown MCP Configuration
# MARKITDOWN_ALLOW_HTTP=false

# Jina Reader API Key (Optional)
# JINA_API_KEY=

# CLI Debug & Logging Configuration
# CLI_DEBUG=1
# CLI_DEBUG_MAX_CHARS=600

# Docker Code Sandbox Configuration (Optional)
# DOCKER_IMAGE_NAME=python-ds:latest
# DOCKER_MAX_MEM=1g
# DOCKER_PIDS_LIMIT=128
# DOCKER_NANO_CPUS=1000000000
# SANDBOX_TIMEOUT_SECONDS=60
# SANDBOX_MAX_TIMEOUT_SECONDS=300
# SANDBOX_IDLE_TTL_SECONDS=1800
# SANDBOX_MAX_STDOUT_CHARS=8000
# SANDBOX_MAX_STDERR_CHARS=3000
# SANDBOX_EXECUTE_MAX_OUTPUT_CHARS=2000000
# SANDBOX_WORK_TMPFS_MB=256
# SANDBOX_MOUNT_WORKSPACE=true
# SANDBOX_IMAGE_VERSION=3
# SANDBOX_MAX_IMAGES=4
# SANDBOX_MAX_IMAGE_MB=10
# SANDBOX_USER_IMAGE_MAX_SIDE=1600
# SANDBOX_MODEL_IMAGE_MAX_SIDE=768

# --- 宿主机命令执行（FileAgent 的 run_host_command）---
# HOST_SHELL_TIMEOUT_SECONDS=60
# HOST_SHELL_MAX_TIMEOUT_SECONDS=180
# HOST_SHELL_MAX_OUTPUT_CHARS=30000
# HOST_SHELL_MAX_COMMAND_CHARS=2000
# 额外放行给命令子进程的环境变量名（逗号分隔）；默认只放行系统运行必需项和代理，绝不继承 .env 里的任何密钥
# HOST_SHELL_ENV_ALLOW=JAVA_HOME,GOPATH

# --- 会话层持久化（会话 / 事件日志 / 挂起授权，以及 LangGraph checkpoint）---
# 两个文件都含完整对话文本，位于被 git 忽略的 storage/
# SESSIONS_DB_PATH=storage/sessions.db
# CHECKPOINT_DB_PATH=storage/checkpoints.db
# 每轮正常结束后清理子专家嵌套命名空间的 checkpoint（截图 base64 会让它们膨胀）；根命名空间永不清理
# CHECKPOINT_PRUNE_NESTED=true

# --- NoneBot / QQ 官方机器人(仅 bot.py 需要;这些行写在 .env 文件里,NoneBot 自己读取它)---
# DRIVER=~fastapi+~httpx+~websockets
# QQ_IS_SANDBOX=false
# QQ_BOTS=[{"id": "你的AppID", "token": "你的Token", "secret": "你的AppSecret", "intent": {"c2c_group_at_messages": true, "direct_message": true}, "use_websocket": true}]
