{
  "amap": {
    "command": "uvx",
    "args": [
      "--quiet",
      "--with",
      "amap-mcp-server==0.1.11",
      "--with",
      "mcp==1.8.1",
      "--with",
      "pydantic==2.10.6",
      "python",
      "app/amap_wrapper.py"
    ],
    "env": {
      "AMAP_MAPS_API_KEY": "${AMAP_API_KEY}"
    },
    "transport": "stdio"
  },
  "filesystem": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-filesystem@2026.8.31",
      "${WORKSPACE_DIR}"
    ],
    "transport": "stdio"
  },
  "desktop": {
    "command": "uv",
    "args": [
      "run",
      "app/windows_mcp.py"
    ],
    "transport": "stdio"
  }
}
