{
  "markitdown": {
    "command": "uvx",
    "args": [
      "--quiet",
      "--from",
      "markitdown-mcp==0.0.1a7",
      "--with",
      "markitdown[all]",
      "markitdown-mcp"
    ],
    "env": {
      "PYTHONUTF8": "1",
      "PYTHONIOENCODING": "utf-8"
    },
    "transport": "stdio"
  },
  "desktop": {
    "command": "uv",
    "args": [
      "run",
      "mcp_servers/windows_desktop.py"
    ],
    "transport": "stdio"
  }
}
